[package]
name = "{{ name }}"
edition = "2024"
version = "0.1.0"

[[bin]]
name = "{{ name }}"
path = "src/main.rs"

[build-dependencies]
gluon-build = { git = "https://github.com/smartcrabai/gluon", {% if gluon_revision %}rev = "{{ gluon_revision }}"{% else %}tag = "v{{ gluon_version }}"{% endif %} }

[dependencies]
async-trait = "0.1"
axum = "0.8"
gluon = { git = "https://github.com/smartcrabai/gluon", {% if gluon_revision %}rev = "{{ gluon_revision }}"{% else %}tag = "v{{ gluon_version }}"{% endif %} }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sqlx = { version = "0.9", features = ["postgres", "runtime-tokio", "uuid"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "signal"] }
tower-sessions = "0.15"
ts-rs = "11"
uuid = { version = "1", features = ["v4", "serde"] }
